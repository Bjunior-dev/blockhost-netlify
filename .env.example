# Salin jadi ".env" untuk development lokal dengan "netlify dev".
# Untuk production, isi ini di Netlify Dashboard -> Site settings -> Environment variables.

# --- Database (Turso / libSQL) ---
# Kosongkan untuk pakai file lokal "file:blockhost.db" saat development.
# Untuk production WAJIB diisi dengan database Turso (lihat README), karena
# Netlify Functions tidak punya penyimpanan file permanen.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Midtrans (QRIS) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
